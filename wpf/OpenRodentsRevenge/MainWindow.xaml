<Window x:Class="OpenRodentsRevenge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Rodent's Revenge"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#202020">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Game">
                <MenuItem Header="_New game" Click="OnActionNewGame"/>
                <MenuItem x:Name="menuSelectLevel" Header="_Select level"/>
                <Separator/>
                <MenuItem x:Name="menuRestartLevel" Header="_Restart level" Click="OnActionRestartLevel"/>
                <Separator/>
                <MenuItem Header="_Play a level from file..." Click="OnActionPlayLevel"/>
            </MenuItem>
            <MenuItem Header="_Editor">
                <MenuItem Header="_New level..." Click="OnActionEditorNewLevel"/>
                <MenuItem Header="Edit an _existing level..." Click="OnActionEditorExistingLevel"/>
                <MenuItem x:Name="menuEditorCurrentLevel" Header="Edit _current level" Click="OnActionEditorCurrentLevel"/>
                <Separator/>
                <MenuItem x:Name="menuEditorSaveLevel" Header="_Save level" Click="OnActionEditorSaveLevel"/>
                <MenuItem x:Name="menuEditorSaveLevelAs" Header="Save level _as..." Click="OnActionEditorSaveLevelAs"/>
                <MenuItem x:Name="menuEditorLevelProperties" Header="Level _properties..." Click="OnActionEditorLevelProperties"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnActionAbout"/>
            </MenuItem>
        </Menu>

        <ToolBarTray x:Name="editorBarTray" DockPanel.Dock="Top" Visibility="Collapsed">
            <ToolBar x:Name="editorBar"/>
        </ToolBarTray>

        <Border DockPanel.Dock="Bottom" Background="#2D2D30" BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock Foreground="#E0E0E0" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="12" MaxWidth="640">
                <Run FontWeight="Bold" Foreground="#FFD24A">How to play:</Run>
                <Run Text=" Move with the "/><Run FontWeight="Bold">arrow keys</Run><Run Text=". Push blocks to surround the cats — trap one completely and it turns into cheese. Clear every cat to reach the next level. "/>
                <Run FontWeight="Bold" Foreground="#FF8A8A">A keyboard is required.</Run>
            </TextBlock>
        </Border>

        <Border x:Name="canvasHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </DockPanel>
</Window>
